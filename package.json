{
  "name": "gpt8-red-square-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "pnpm --parallel --filter @gpta/server --filter @gpta/web dev",
    "build": "pnpm --filter @gpta/web build && pnpm --filter @gpta/server build",
    "deploy": "pnpm --filter @gpta/web build && pnpm --filter @gpta/server deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --parallel --filter @gpta/core --filter @gpta/server --filter @gpta/web test",
    "lint": "oxlint --deny-warnings apps packages",
    "lint:fix": "oxlint --fix apps packages",
    "format": "oxfmt .",
    "format:check": "git ls-files -z | xargs -0 oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "storybook": "pnpm --filter @gpta/web storybook",
    "cf-typegen": "pnpm --filter @gpta/server cf-typegen",
    "prepare": "husky"
  },
  "dependencies": {
    "three": "catalog:legacy",
    "ws": "catalog:legacy"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.22.0"
}
