{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "tools/oxlint/anti-slop/**",
    ".agents/**",
    ".codex/**",
    ".claude/**",
    "public/**",
    "source/**",
    "test/**",
