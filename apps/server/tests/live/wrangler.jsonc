{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gpta-live-conversation-test",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "WORLD", "class_name": "World" },
      { "name": "PERSON", "class_name": "Person" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["World"] },
    { "tag": "v2", "new_sqlite_classes": ["Person"] },
  ],
  "workflows": [
    { "name": "gpta-live-decision", "binding": "DECISIONS", "class_name": "AstraDecision" },
    {
      "name": "gpta-live-conversation",
      "binding": "CONVERSATIONS",
      "class_name": "AstraConversation",
    },
  ],
  "vars": { "OPENAI_MODEL": "gpt-6-astra", "WORLD_NAME": "conversation-live" },
}
